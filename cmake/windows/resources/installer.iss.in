#define MyAppName "@CMAKE_PROJECT_NAME@"
#define MyAppVersion "@CMAKE_PROJECT_VERSION@"
#define MyAppPublisher "@PLUGIN_AUTHOR@"
#define MyAppURL "@PLUGIN_WEBSITE@"

[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{406C14FF-FD57-404E-93C9-659DCA3E8600}}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={commonappdata}\obs-studio\plugins\obs-pptlink
DefaultGroupName={#MyAppName}
OutputBaseFilename={#MyAppName}-{#MyAppVersion}-windows-x64-installer
OutputDir=@CMAKE_CURRENT_SOURCE_DIR@/release
Compression=lzma
SolidCompression=yes
DirExistsWarning=no
DisableProgramGroupPage=yes
DisableReadyPage=no

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[InstallDelete]
Type: filesandordirs; Name: "{app}\bin"; Check: UseModernLayout
Type: files; Name: "{app}\{#MyAppName}.dll"; Check: not UseModernLayout
Type: files; Name: "{app}\{#MyAppName}.pdb"; Check: not UseModernLayout

[Files]
; Package-Windows.ps1 installs to release\<Config>\<PluginName>\ before running iscc.
Source: "@CMAKE_CURRENT_SOURCE_DIR@\release\Package\{#MyAppName}\*"; \
  DestDir: "{app}"; Flags: ignoreversion; Check: UseModernLayout
Source: "@CMAKE_CURRENT_SOURCE_DIR@\release\Package\{#MyAppName}\*"; \
  DestDir: "{app}\bin\64bit"; Flags: ignoreversion; Check: not UseModernLayout
Source: "@CMAKE_CURRENT_SOURCE_DIR@\release\Package\{#MyAppName}\data\*"; \
  DestDir: "{app}\data"; Flags: recursesubdirs createallsubdirs ignoreversion

[Icons]
Name: "{group}\{cm:ProgramOnTheWeb,{#MyAppName}}"; Filename: "{#MyAppURL}"

[Code]
const
  MinObsMajor = 31;
  ModernLayoutObsMajor = 33;

var
  ObsMajor: Integer;

function GetObsMajor(): Integer;
var
  InstallDir, Version: String;
  P: Integer;
begin
  Result := 0;
  if RegQueryStringValue(HKLM64, 'SOFTWARE\OBS Studio', '', InstallDir) and
     GetVersionNumbersString(AddBackslash(InstallDir) + 'bin\64bit\obs64.exe', Version) then
  begin
    P := Pos('.', Version);
    if P > 0 then
      Result := StrToIntDef(Copy(Version, 1, P - 1), 0);
  end;
end;

function UseModernLayout(): Boolean;
begin
  Result := (ObsMajor = 0) or (ObsMajor >= ModernLayoutObsMajor);
end;

// Abort if OBS Studio is running — the DLL cannot be replaced while loaded.
function InitializeSetup(): Boolean;
begin
  Result := True;
  if CheckForMutexes('OBSMutex') then
  begin
    MsgBox('OBS Studio is running. Please close it before installing {#MyAppName}.', mbError, MB_OK);
    Result := False;
    Exit;
  end;

  ObsMajor := GetObsMajor();
  if (ObsMajor > 0) and (ObsMajor < MinObsMajor) then
  begin
    MsgBox(Format('{#MyAppName} requires OBS Studio %d or later. Please update OBS Studio before installing.', [MinObsMajor]), mbError, MB_OK);
    Result := False;
  end;
end;